{
  "expo": {
    "name": "Talli",
    "slug": "tally",
    "scheme": "tally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Talli uses your photo library to set a profile picture."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Talli uses your microphone to let you dictate messages to Talli AI.",
          "speechRecognitionPermission": "Talli uses speech recognition to turn what you say into text for Talli AI."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.folio.tally",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Talli uses speech recognition to turn what you say into text for Talli AI.",
        "NSMicrophoneUsageDescription": "Talli uses your microphone to let you dictate messages to Talli AI.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.folio.tally",
      "adaptiveIcon": {
        "backgroundColor": "#F4EEDF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94d25684-236d-4306-9b18-fb3db86316c1"
      }
    }
  }
}
